# Puerto HTTP (el servidor escucha en 0.0.0.0)
PORT=3000
# Fichero SQLite. En Coolify: /data/tokiohouse.db (volumen persistente en /data)
DATABASE_PATH=./data/tokiohouse.db
# Origen del front permitido por CORS (con credenciales)
CORS_ORIGIN=http://localhost:5173
# "production" activa la cookie Secure
NODE_ENV=development
