{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx hono *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "WebFetch(domain:hono.dev)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:sqlite.org)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(npm publish *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(**/*.db)",
      "Read(**/*.db-*)",
      "Read(**/*.sqlite)"
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
